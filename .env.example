# ==================================================
# ArcadiaX Bot & Backend Environment Configuration
# ==================================================

# Node Environment ('development' | 'production')
NODE_ENV=development
PORT=5000

# Discord Bot Credentials (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

DISCORD_CLIENT_ID=1570011387143659530
DISCORD_CLIENT_SECRET=fJDLkldFHxCpQklFj2Meb37a6PsktSjh

# Single-Server Target Guild and Authorization
# Only this Discord server will be managed by ArcadiaX
DISCORD_GUILD_ID=1569623215007866961
DISCORD_OWNER_ID=1482716857642516633

# Additional Dashboard Administrator Discord IDs (comma-separated, no spaces)
# Example: 123456789012345678,987654321098765432
ADMIN_USER_IDS=1554642518719594552

# Dashboard & API URLs
# DASHBOARD_URL: The URL where your React dashboard is hosted
DASHBOARD_URL=http://localhost:3000
# API_URL: The URL where this Express backend is hosted
API_URL=http://localhost:5000

# Discord OAuth2 Redirect URI (Must match Discord Developer Portal OAuth2 Redirects)
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Session Security (Generate a long 64-char random string in production)
SESSION_SECRET=arcadiax_super_secret_session_encryption_key_change_me

# Database File Path (Relative or Absolute path to SQLite .db file)
DATABASE_PATH=./data/arcadiax.db
